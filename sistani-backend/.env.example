# Salin file ini menjadi .env lalu sesuaikan isinya.

# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgresql+psycopg2://postgres:password_postgres_kamu@localhost:5432/sistani

# Kunci rahasia untuk token login. Ganti dengan teks acak yang panjang.
# Cara membuatnya: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-teks-acak-yang-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Akun admin yang dibuat otomatis saat server pertama kali jalan
ADMIN_NAMA=Admin SISTANI
ADMIN_EMAIL=admin@sistani.id
ADMIN_PASSWORD=ganti_password_admin_ini

# Premium (simulasi pembayaran)
HARGA_PREMIUM=49000
DURASI_PREMIUM_HARI=30

# Alamat frontend yang boleh memanggil API ini, pisahkan dengan koma.
# Contoh: http://localhost:5173,http://localhost:3000   (tanda * = semua, hanya untuk belajar)
CORS_ORIGINS=*

# Batas keyakinan diagnosis. Di bawah angka ini hasilnya ditandai "kurang yakin".
AMBANG_CONFIDENCE=0.6

# Lokasi cadangan jika nama lokasi kebun tidak ditemukan (default: Balikpapan)
DEFAULT_LAT=-1.2379
DEFAULT_LON=116.8529
