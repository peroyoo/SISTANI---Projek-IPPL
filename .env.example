# Salin menjadi .env lalu sesuaikan.

# Alamat backend FastAPI (uvicorn app.main:app --reload)
VITE_API_URL=http://127.0.0.1:8000

# Harga yang DITAMPILKAN di landing page (halaman publik belum bisa membaca harga dari server).
# Samakan dengan HARGA_PREMIUM di .env backend. Di halaman Premium harga selalu diambil dari server.
VITE_HARGA_PREMIUM=9000
